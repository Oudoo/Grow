# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js — the production build IS tracked (see root .gitignore): Hostinger
# serves the app straight from the repo and never runs `next build` there, so
# dropping .next takes the site down. Cache and source maps stay out.
/.next/cache/
/.next/**/*.map
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.worktrees/

# Allow the template (no secrets)
!.env.example

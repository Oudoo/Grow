generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x", "rhel-openssl-1.0.x", "linux-musl", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Suite {
  id       String    @id @default(uuid())
  suite    String
  suiteAr  String
  slug     String    @unique
  category String    @default("tech") // "creative" (marketing) | "tech" (systems)
  products Product[]
}

model Product {
  id          String  @id @default(uuid())
  name        String
  nameAr      String
  slug        String  @unique
  description String
  descAr      String
  status      String  @default("PUBLISHED") // PUBLISHED, DRAFT
  order       Int     @default(0)
  features    String? @db.Text
  suiteId     String
  suite       Suite   @relation(fields: [suiteId], references: [id], onDelete: Cascade)
}

model Submission {
  id           String    @id @default(uuid())
  name         String
  email        String
  company      String
  message      String    @db.Text
  date         DateTime  @default(now())
  status       String    @default("new")
  called       String    @default("no")
  notes        String?   @db.Text
  priority     String    @default("MEDIUM") // HOT, WARM, COLD, MEDIUM
  dealValue    Int       @default(0)
  source       String    @default("Website") // Website, Referral, LinkedIn, WhatsApp, Direct
  nextFollowUp DateTime?
}

// Project Management Models
model Project {
  id          String   @id @default(uuid())
  title       String
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tasks       Task[]
}

model Task {
  id          String       @id @default(uuid())
  title       String
  description String?      @db.Text
  // Display name of the owner, denormalised so the board renders without a
  // join and historical tasks keep a readable owner even if the account goes.
  assignee    String       @default("Unassigned")
  // The IAM account that owns this task. Nullable because "Unassigned" is a
  // real state and because tasks predate the IAM link. `assignee` is kept in
  // sync on every write — treat assigneeId as the source of truth.
  assigneeId  String?
  status      String       @default("PENDING") // PENDING, IN_PROGRESS, DONE
  priority    String       @default("MEDIUM") // URGENT, HIGH, MEDIUM, LOW
  dueDate     DateTime?
  /// Set when status first becomes DONE; cleared if the task is reopened.
  completedAt DateTime?
  projectId   String
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  subTasks    SubTask[]
  comments    Comment[]
  attachments Attachment[]
  activities  Activity[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // "My Work" queries every task for one person across all projects; the
  // due-date reminder sweep scans upcoming/overdue dates across the table.
  @@index([assigneeId])
  @@index([dueDate])
  @@index([projectId, status])
}

model SubTask {
  id          String   @id @default(uuid())
  title       String
  isCompleted Boolean  @default(false)
  taskId      String
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Comment {
  id        String   @id @default(uuid())
  content   String   @db.Text
  author    String
  /// IAM account that wrote this. Nullable for comments made before the link.
  authorId  String?
  /// Resolved @mentions as a JSON array of AdminUser ids, captured at write
  /// time. Storing the resolution (rather than re-parsing on render) keeps
  /// highlighting stable when someone is later renamed or deactivated.
  mentions  String?  @db.Text
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([taskId, createdAt])
}

model Attachment {
  id        String   @id @default(uuid())
  url       String   @db.Text
  name      String
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

/// Per-task audit trail: who changed what, when. Written by the projects
/// actions on every mutation so accountability does not depend on memory.
/// `field`/`from`/`to` are free-form so new tracked fields need no migration.
model Activity {
  id        String   @id @default(uuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  /// IAM account that performed the action (null for system/automated events).
  actorId   String?
  actorName String   @default("System")
  /// created | status | assignee | priority | due | title | comment | subtask | attachment
  kind      String
  field     String?
  fromValue String?  @db.Text
  toValue   String?  @db.Text
  createdAt DateTime @default(now())

  @@index([taskId, createdAt])
}

/// In-app notification, and the outbox for its email copy.
///
/// Delivery is deliberately decoupled from the action that created it: a
/// mention or an assignment writes a row and returns immediately, so a slow or
/// misconfigured SMTP server can never make saving a comment fail or hang.
/// `emailedAt` marks a successful send, `emailAttempts` bounds the retries.
model Notification {
  id        String    @id @default(uuid())
  /// Recipient AdminUser id.
  userId    String
  /// mention | assigned | due_soon | overdue | comment | status
  kind      String
  title     String
  body      String?   @db.Text
  /// Deep link into the app, e.g. /admin/projects/<id>?task=<taskId>
  url       String?   @db.Text
  taskId    String?
  /// Who triggered it — for "X mentioned you" without a join.
  actorName String?
  readAt    DateTime?

  // ── email outbox ──
  /// Null while queued; set on a successful send. Skipped entirely when the
  /// recipient has no email or notifications are disabled.
  emailedAt     DateTime?
  emailAttempts Int       @default(0)
  emailError    String?   @db.Text

  createdAt DateTime @default(now())

  // The bell queries unread-by-user; the dispatcher scans the unsent outbox.
  @@index([userId, readAt])
  @@index([emailedAt, emailAttempts])
}

// ── Team chat ──────────────────────────────────────────────────────────────

/// A chat channel. Membership is explicit rather than "everyone sees
/// everything", so a channel can be scoped to the people who need it — and a
/// client-facing channel later needs no schema change.
model Channel {
  id          String   @id @default(uuid())
  /// URL-safe name, unique. Displayed with a leading # in the UI.
  slug        String   @unique
  name        String
  topic       String?  @db.Text
  /// Open channels are joinable by any staff account; private ones need an
  /// explicit membership row.
  isPrivate   Boolean  @default(false)
  /// A direct message conversation. Modelled as a channel rather than a separate
  /// entity so messages, threads, reactions, attachments and read state all work
  /// without a parallel implementation. DMs are always private, never listed in
  /// the browsable channel list, and named from their members at render time.
  isDm        Boolean  @default(false)
  /// Sorted, joined member ids for a DM ("a|b"), so looking up "the conversation
  /// with this person" is one indexed read instead of a join per candidate.
  dmKey       String?  @unique
  /// AdminUser id of the creator. Kept even if that account goes.
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members  ChannelMember[]
  messages ChatMessage[]
}

/// One person's membership of one channel, and their read position.
///
/// `lastReadAt` is the whole unread mechanism: unread count is messages in the
/// channel newer than this. Storing a timestamp rather than a per-message read
/// flag keeps it one row per person per channel instead of one per message.
model ChannelMember {
  id         String    @id @default(uuid())
  channelId  String
  channel    Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  /// AdminUser id — no FK, since AdminUser is in the same schema but members
  /// may be seeded before accounts exist.
  userId     String
  lastReadAt DateTime?
  joinedAt   DateTime  @default(now())

  /// One membership per person per channel.
  @@unique([channelId, userId])
  @@index([userId])
}

model ChatMessage {
  id         String        @id @default(uuid())
  channelId  String
  channel    Channel       @relation(fields: [channelId], references: [id], onDelete: Cascade)
  /// AdminUser id of the author.
  authorId   String
  /// Denormalised so an old message still shows a name if the account is gone.
  authorName String
  body       String        @db.Text
  /// Resolved @mentions as a JSON array of AdminUser ids, captured at write
  /// time — same approach as task comments, so highlighting survives a rename.
  mentions   String?       @db.Text
  /// Set when the author edits. Non-null renders the "edited" marker — silently
  /// changing a message someone has already read is worse than the typo.
  editedAt   DateTime?
  /// Parent message for a threaded reply; null for a top-level message. One
  /// level only: a reply cannot itself have replies, which keeps a conversation
  /// readable and the query a single indexed lookup.
  parentId   String?
  parent     ChatMessage?  @relation("MessageThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies    ChatMessage[] @relation("MessageThread")

  reactions   MessageReaction[]
  attachments ChatAttachment[]
  createdAt   DateTime          @default(now())

  /// A channel's top-level messages, newest last. parentId is in the index so
  /// the main view can exclude replies without a second pass.
  @@index([channelId, parentId, createdAt])
  /// A thread's replies.
  @@index([parentId, createdAt])
}

/// One person's one reaction of one kind to one message.
///
/// A row per (message, user, emoji) rather than a count: a count cannot tell you
/// whether *you* already reacted, which is what the UI needs in order to toggle.
model MessageReaction {
  id        String      @id @default(uuid())
  messageId String
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  /// A single emoji from a fixed set, validated on write — free text here would
  /// become a second message field.
  emoji     String
  createdAt DateTime    @default(now())

  @@unique([messageId, userId, emoji])
  @@index([messageId])
}

/// A file attached to a chat message.
///
/// The file itself lives OUTSIDE the deploy directory (see lib/uploads.ts), for
/// the same reason .grow.env does: a redeploy replaces the app directory, and
/// anything stored inside it would be destroyed. Only metadata is here.
model ChatAttachment {
  id         String      @id @default(uuid())
  messageId  String
  message    ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  /// Name as uploaded, shown to people. Never used to build a filesystem path.
  fileName   String
  /// Validated against an allow-list on upload.
  mimeType   String
  sizeBytes  Int
  /// Filename on disk — a generated id plus extension, never user input.
  storageKey String
  uploadedBy String
  createdAt  DateTime    @default(now())

  @@index([messageId])
}

/// Admin-editable system configuration: one row per setting, value as JSON.
///
/// Exists so option lists (task statuses, priorities, …) can be changed from the
/// admin console instead of requiring a code change and a deploy. Deliberately
/// a key/value store rather than a column per setting: adding a new configurable
/// list must not need a migration, which is the whole point.
///
/// A missing row means "use the built-in default" — see lib/config-types.ts. The
/// table starting empty is therefore the correct initial state, and deleting a
/// row is a safe way to reset one setting.
model SystemSetting {
  /// Stable identifier, e.g. "projects.statuses". Never shown to users.
  key       String   @id
  /// JSON payload. Shape is per-key and validated on write, not by the schema.
  value     String   @db.Text
  /// AdminUser id of whoever last changed it — configuration is worth auditing.
  updatedBy String?
  updatedAt DateTime @updatedAt
}

// Finance & Invoicing
model Invoice {
  id         String    @id @default(uuid())
  invoiceNo  String    @unique
  clientName String
  amount     Float
  status     String    @default("DRAFT") // DRAFT, SENT, PAID, OVERDUE
  issueDate  DateTime  @default(now())
  dueDate    DateTime?
  notes      String?   @db.Text
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

// Support & Ticketing
model Ticket {
  id          String   @id @default(uuid())
  title       String
  description String   @db.Text
  clientName  String
  status      String   @default("OPEN") // OPEN, IN_PROGRESS, RESOLVED, CLOSED
  priority    String   @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// IAM – Admin Users
model AdminUser {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("VIEWER") // SUPER_ADMIN, ADMIN, MEMBER, VIEWER, CLIENT
  permissions  String?  @db.Text // LEGACY on/off JSON array — superseded by `access`
  // Per-module access levels: {"crm":"manage","engine":"view",…} with none|view|manage
  access       String?  @db.Text
  // For CLIENT users: the engine client (clients.id) this account is scoped to
  clientId     String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Per-client tool entitlements + white-label branding. Keyed by the engine
// client id (no cross-ORM FK). Admin-granted: flipping a tool on here grants
// it to ALL of that client's CLIENT users (inherited at login). Branding +
// subdomain drive the white-labeled client portal.
model ClientAccess {
  clientId     String   @id
  tools        String?  @db.Text // JSON array of entitled product keys, e.g. ["engine","chatbot"]
  brandName    String?
  logoUrl      String?  @db.Text
  primaryColor String?
  accentColor  String?
  subdomain    String?  @unique // <subdomain>.growcdx.com
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// White-label / Tenant config
model TenantConfig {
  id             String   @id @default("default")
  companyName    String   @default("GROW")
  tagline        String?
  primaryColor   String   @default("#4F46E5")
  secondaryColor String   @default("#4338CA")
  logoUrl        String?
  fontHeading    String   @default("Neue Montreal / Archivo")
  fontBody       String   @default("SF Pro / Roboto Mono")
  contactEmail   String?
  contactPhone   String?
  address        String?
  isDemo         Boolean  @default(false)
  updatedAt      DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────
// Growees Producer — recruitment module
// Tables prefixed `producer_` to keep the shared database cleanly organized.
// Long-text columns use @db.Text (CVs, blueprints, generated HTML, notes).
// ─────────────────────────────────────────────────────────────────────────
model Vacancy {
  id              String   @id @default(cuid())
  title           String
  department      String?
  location        String?
  salaryBudgetMin Float?
  salaryBudgetMax Float?
  acceptanceScore Float    @default(3.8)
  jobPostingHtml  String   @db.Text
  rawBlueprint    String   @db.Text
  status          String   @default("open")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  competencies Competency[]
  candidates   Candidate[]

  @@map("producer_vacancies")
}

model Competency {
  id        String @id @default(cuid())
  vacancyId String
  name      String
  category  String // "hard" | "soft"
  weight    Float
  order     Int

  vacancy Vacancy @relation(fields: [vacancyId], references: [id], onDelete: Cascade)
  scores  Score[]

  @@index([vacancyId])
  @@map("producer_competencies")
}

model Candidate {
  id              String   @id @default(cuid())
  vacancyId       String
  name            String
  email           String
  phone           String?
  yearsExperience Float?
  expectedSalary  Float?
  rawCv           String   @db.Text
  portfolioUrl    String?  @db.Text
  portfolioTitle  String?
  portfolioImage  String?  @db.Text
  portfolioDesc   String?  @db.Text
  compositeScore  Float?
  status          String   @default("pending")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  vacancy    Vacancy     @relation(fields: [vacancyId], references: [id], onDelete: Cascade)
  scorecards Scorecard[]
  offer      Offer?

  @@index([vacancyId])
  @@map("producer_candidates")
}

model Scorecard {
  id          String   @id @default(cuid())
  candidateId String
  managerName String
  submittedAt DateTime @default(now())

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  scores    Score[]

  @@index([candidateId])
  @@map("producer_scorecards")
}

model Score {
  id           String  @id @default(cuid())
  scorecardId  String
  competencyId String
  value        Int
  notes        String? @db.Text

  scorecard  Scorecard  @relation(fields: [scorecardId], references: [id], onDelete: Cascade)
  competency Competency @relation(fields: [competencyId], references: [id], onDelete: Cascade)

  @@unique([scorecardId, competencyId])
  @@index([scorecardId])
  @@index([competencyId])
  @@map("producer_scores")
}

model Offer {
  id               String   @id @default(cuid())
  candidateId      String   @unique
  offeredSalary    Float
  firstWorkingDate String
  contractType     String
  itEquipment      String?
  status           String   @default("draft")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@map("producer_offers")
}

# ── GROW Hub — environment ──
# Copy to .env (local) or set these as Environment Variables in Hostinger.

# Database — Hostinger MySQL (Websites → your hub → Databases → create one)
# Format: mysql://USER:PASSWORD@HOST:3306/DBNAME
DATABASE_URL="mysql://user:password@localhost:3306/grow_os_core"

# Admin gate — set ONE of these. Hash is preferred (generate with:
#   node scripts/hash-password.mjs "YourStrongCode")
# For a quick demo you may instead set the plaintext ADMIN_PASSWORD.
ADMIN_PASSWORD_HASH=""
ADMIN_PASSWORD="GrowDemo2026"

# Session signing secret (use a long random string in production)
AUTH_SECRET="change-me-to-a-32+char-random-string"

# Integrated system consoles (point these at your deployed Engine / Producer URLs)
GROW_ENGINE_URL="https://your-engine.hostingersite.com"
GROWEES_PRODUCER_URL="https://your-producer.hostingersite.com"

# Optional: WhatsApp lead routing
# GROW_SALES_WHATSAPP_TO=""

# ── Email notifications (Hostinger SMTP) ──
# Create a mailbox in hPanel → Emails, then set these. Until they are set the
# app runs normally: notifications appear in-app and queue for email, and the
# queue drains automatically once these values exist.
# In production put these in .grow.env (outside the deploy directory), not here.
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"                 # 465 = implicit TLS, 587 = STARTTLS
SMTP_USER="notifications@growcdx.com"
SMTP_PASS=""
MAIL_FROM="GROW <notifications@growcdx.com>"

# Absolute base URL used for deep links inside notification emails.
APP_URL="https://growcdx.com"

# Shared secret for the scheduled notification dispatcher. Generate with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# Then run every 15 minutes from hPanel → Advanced → Cron Jobs:
#   curl -fsS -H "x-cron-secret: $CRON_SECRET" https://growcdx.com/api/notifications/dispatch
CRON_SECRET=""

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Suite {
  id       String    @id @default(uuid())
  suite    String
  suiteAr  String
  slug     String    @unique
  category String    @default("tech") // "creative" (marketing) | "tech" (systems)
  products Product[]
}

model Product {
  id          String @id @default(uuid())
  name        String
  nameAr      String
  slug        String @unique
  description String
  descAr      String
  status      String @default("PUBLISHED") // PUBLISHED, DRAFT
  order       Int    @default(0)
  features    String? @db.Text
  suiteId     String
  suite       Suite  @relation(fields: [suiteId], references: [id], onDelete: Cascade)
}

model Submission {
  id      String   @id @default(uuid())
  name    String
  email   String
  company String
  message String   @db.Text
  date    DateTime @default(now())
  status        String    @default("new")
  called        String    @default("no")
  notes         String?   @db.Text
  priority      String    @default("MEDIUM") // HOT, WARM, COLD, MEDIUM
  dealValue     Int       @default(0)
  source        String    @default("Website") // Website, Referral, LinkedIn, WhatsApp, Direct
  nextFollowUp  DateTime?
}

// Project Management Models
model Project {
  id          String   @id @default(uuid())
  title       String
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tasks       Task[]
}

model Task {
  id          String       @id @default(uuid())
  title       String
  description String?      @db.Text
  assignee    String       @default("Unassigned")
  status      String       @default("PENDING") // PENDING, IN_PROGRESS, DONE
  projectId   String
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  subTasks    SubTask[]
  comments    Comment[]
  attachments Attachment[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model SubTask {
  id          String   @id @default(uuid())
  title       String
  isCompleted Boolean  @default(false)
  taskId      String
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Comment {
  id        String   @id @default(uuid())
  content   String   @db.Text
  author    String
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Attachment {
  id        String   @id @default(uuid())
  url       String   @db.Text
  name      String
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

// Finance & Invoicing
model Invoice {
  id          String   @id @default(uuid())
  invoiceNo   String   @unique
  clientName  String
  amount      Float
  status      String   @default("DRAFT") // DRAFT, SENT, PAID, OVERDUE
  issueDate   DateTime @default(now())
  dueDate     DateTime?
  notes       String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Support & Ticketing
model Ticket {
  id          String   @id @default(uuid())
  title       String
  description String   @db.Text
  clientName  String
  status      String   @default("OPEN") // OPEN, IN_PROGRESS, RESOLVED, CLOSED
  priority    String   @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// IAM – Admin Users
model AdminUser {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("VIEWER") // SUPER_ADMIN, ADMIN, VIEWER
  permissions  String?  @db.Text // JSON array: ["crm","finance","products","projects","support","analytics","iam"]
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// White-label / Tenant config
model TenantConfig {
  id             String   @id @default("default")
  companyName    String   @default("GROW")
  tagline        String?
  primaryColor   String   @default("#4F46E5")
  secondaryColor String   @default("#4338CA")
  logoUrl        String?
  fontHeading    String   @default("Neue Montreal / Archivo")
  fontBody       String   @default("SF Pro / Roboto Mono")
  contactEmail   String?
  contactPhone   String?
  address        String?
  isDemo         Boolean  @default(false)
  updatedAt      DateTime @updatedAt
}

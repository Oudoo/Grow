datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x", "rhel-openssl-1.0.x", "linux-musl", "linux-musl-openssl-3.0.x"]
}

model Vacancy {
  id              String   @id @default(cuid())
  title           String
  department      String?
  location        String?
  salaryBudgetMin Float?
  salaryBudgetMax Float?
  acceptanceScore Float    @default(3.8)
  jobPostingHtml  String
  rawBlueprint    String
  status          String   @default("open")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  competencies Competency[]
  candidates   Candidate[]
}

model Competency {
  id        String @id @default(cuid())
  vacancyId String
  name      String
  category  String // "hard" | "soft"
  weight    Float
  order     Int

  vacancy Vacancy @relation(fields: [vacancyId], references: [id], onDelete: Cascade)
  scores  Score[]

  @@index([vacancyId])
}

model Candidate {
  id              String   @id @default(cuid())
  vacancyId       String
  name            String
  email           String
  phone           String?
  yearsExperience Float?
  expectedSalary  Float?
  rawCv           String
  portfolioUrl    String?
  portfolioTitle  String?
  portfolioImage  String?
  portfolioDesc   String?
  compositeScore  Float?
  status          String   @default("pending")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  vacancy    Vacancy     @relation(fields: [vacancyId], references: [id], onDelete: Cascade)
  scorecards Scorecard[]
  offer      Offer?

  @@index([vacancyId])
}

model Scorecard {
  id          String   @id @default(cuid())
  candidateId String
  managerName String
  submittedAt DateTime @default(now())

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  scores    Score[]

  @@index([candidateId])
}

model Score {
  id           String @id @default(cuid())
  scorecardId  String
  competencyId String
  value        Int
  notes        String?

  scorecard  Scorecard  @relation(fields: [scorecardId], references: [id], onDelete: Cascade)
  competency Competency @relation(fields: [competencyId], references: [id], onDelete: Cascade)

  @@unique([scorecardId, competencyId])
  @@index([scorecardId])
  @@index([competencyId])
}

model Offer {
  id               String   @id @default(cuid())
  candidateId      String   @unique
  offeredSalary    Float
  firstWorkingDate String
  contractType     String
  itEquipment      String?
  status           String   @default("draft")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
}

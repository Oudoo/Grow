# Dependencies
node_modules

# Build output
# .next
dist
build
out
coverage
*.tsbuildinfo

# Local databases (regenerated via db:push + seed)
*.db
*.db-journal

# Environment — never commit secrets
.env
.env.local
.env.*.local

# Logs & OS
*.log
.DS_Store

# Editor
.idea

# Local MCP config (contains API token — never commit)
.mcp.json

# Build output is not tracked — EXCEPT the hub's production build.
# Hostinger deploys straight from git and does not run `next build` on the
# server, so the built app has to ship in the repo or the site serves nothing.
# The webpack cache and source maps are excluded: they are the bulk of the
# size (91MB of .map alone) and neither is needed to serve the app.
**/.next/
!apps/grow/.next/
apps/grow/.next/cache/
apps/grow/.next/**/*.map
